<?xml version="1.0" encoding="utf-8"?>
<!--
  UnityEngine.Modules 2020.3.45 (matching Rain World's Unity 2020.3.45f1) and
  BepInEx.Core 5.4.17 (matching the BepInEx the game bundles) are only on the
  BepInEx feed. nuget.org carries a UnityEngine.Modules id but only at 2021.3.33,
  and no BepInEx.Core at all.

  <clear /> is deliberate: without it a machine-level NuGet.Config can inject an
  extra source and change which package wins, which is a reproducibility hazard
  for a mod whose whole job is to match the game's exact assembly versions.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="BepInEx" value="https://nuget.bepinex.dev/v3/index.json" />
  </packageSources>
</configuration>
